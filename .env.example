# Base de données (Postgres)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Formulaire de contact (SMTP o2switch)
# SMTP_HOST doit être le serveur réel (serflex.o2switch.net) : mail.opierre.fr
# est capturé par le wildcard DNS vers Vercel et ne répond pas en SMTP.
SMTP_HOST=serflex.o2switch.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Dashboard d'administration
ADMIN_PASSWORD=
ADMIN_TOKEN=
